#include <iostream>
#include <cstdio>
#include <string>
using namespace std;

int main()
{
    int x[10][10];
    for (int i = 0; i < 10; i++)
    {
        for (int j = 0; j < 10; j++)
        {
            x[i][j] = (j + 1) * (i + 1);
        }
    }
    cout << "+" << string(41, '=') << "+" << endl;
    for (int i = 0; i < 10; i++)
    {
        cout << "| ";
        for (int j = 0; j < 10; j++)
        {
            printf("%0*d ", 3, x[i][j]); 
        }
        cout << "|" << endl;
    }
    cout << "+" << string(41, '=') << "+" << endl;
    return 0;
}
