#include <iostream>
using namespace std;

int MyPower(int Base, int Power)
{
    if (Power == 0)
    {
        return 1;
    }
    else
    {
        return (Base * MyPower(Base, Power - 1));
    }
}

int main()
{
    cout << "Result of 2^4 = " << MyPower(2, 4) << endl;

    return 0;
}
