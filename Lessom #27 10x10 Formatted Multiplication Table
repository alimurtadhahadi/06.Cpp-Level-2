#include <iostream>
#include <cstdio>
#include <string>
using namespace std;
char GetAscii(int code)
{
    return (unsigned char)code;
}
int main()
{
    char TL = GetAscii(201); // ╔
    char TR = GetAscii(187); // ╗
    char BL = GetAscii(200); // ╚
    char BR = GetAscii(188); // ╝
    char H = GetAscii(205); // ═
    char V = GetAscii(186); // ║
    char ML = GetAscii(204); // ╠
    char MR = GetAscii(185); // ╣
    int x[10][10];
    for (int i = 0; i < 10; i++)
    {
        for (int j = 0; j < 10; j++)
        {
            x[i][j] = (j + 1) * (i + 1);
        }
    }
    cout << TL << string(41, H) << TR << endl;
    for (int i = 0; i < 10; i++)
    {
        cout << V << " ";
        for (int j = 0; j < 10; j++)
        {
            printf("%0*d ", 3, x[i][j]);
        }
        cout << V << endl;
    }
    cout << BL << string(41, H) << BR << endl;
    return 0;
}
